# ===========================================
# Variables de entorno para Expo Notes App
# ===========================================
# NOTA EDUCATIVA: Normalmente este archivo NO se sube a Git
# ya que puede contener claves secretas. Lo incluimos aquí
# con fines educativos para mostrar cómo funciona.
# ===========================================

# API de citas (ZenQuotes)
EXPO_PUBLIC_QUOTES_API_URL=https://zenquotes.io/api/random

# API de imágenes aleatorias (Lorem Picsum)
EXPO_PUBLIC_IMAGES_API_URL=https://picsum.photos

# Configuración de la API
EXPO_PUBLIC_API_TIMEOUT=10000
